@app.callback(Output('etf-breakdown', 'children'), Input('amount-slider', 'value'), State('theme-toggle', 'value'))
def update_etf_allocation(amount, theme):
    rows = []
    total_alloc = 0
    cash_left = 0
    for _, etf in etf_df.iterrows():
        price = etf['price']
        weight = etf['weight']
        alloc = amount * weight
        shares = int(alloc // price)
        spent = shares * price
        remaining = alloc - spent
        total_alloc += spent
        cash_left += remaining
        rows.append(html.Tr([
            html.Td(etf['sector']), html.Td(etf['etf_name']), html.Td(etf['ticker']), html.Td(etf['isin']),
            html.Td(f"${price:.2f}"), html.Td(f"{weight:.2%}"), html.Td(f"{shares}"),
            html.Td(f"${spent:.2f}"), html.Td(f"${remaining:.2f}")
        ]))
    rows.append(html.Tr([html.Td("Total", colSpan=7), html.Td(f"${total_alloc:.2f}"), html.Td(f"${cash_left:.2f}")]))
    return html.Table(className="custom-table", children=[
        html.Thead(html.Tr([
            html.Th("Sector"), html.Th("ETF Name"), html.Th("Ticker"), html.Th("ISIN"),
            html.Th("Price"), html.Th("Weight"), html.Th("Shares"),
            html.Th("Cost"), html.Th("Cash Left")
        ])),
        html.Tbody(rows)
    ], style={"width": "100%", "textAlign": "center", "border": "1px solid gray", "borderCollapse": "collapse", "borderSpacing": "0"})

def build_etf_dataframe(amount):
    output = []
    for _, etf in etf_df.iterrows():
        price = etf['price']
        weight = etf['weight']
        alloc = amount * weight
        shares = int(alloc // price)
        spent = shares * price
        remaining_cash = alloc - spent
        output.append({
            "Sector": etf['sector'],
            "ETF Name": etf['etf_name'],
            "Ticker": etf['ticker'],
            "ISIN": etf['isin'],
            "Price": f"${price:.2f}",
            "Weight": f"{weight:.2%}",
            "Shares": shares,
            "Cost": f"${spent:.2f}",
            "Cash Left": f"${remaining_cash:.2f}"
        })
    return pd.DataFrame(output)

@app.callback(
    Output("download-etf-csv", "data"),
    Input("download-etf-btn-csv", "n_clicks"),
    State("amount-slider", "value"),
    prevent_initial_call=True
)
def download_csv(n, amount):
    df = build_etf_dataframe(amount)
    return dcc.send_data_frame(df.to_csv, "etf_allocation.csv", index=False)

@app.callback(
    Output("download-etf-pdf", "data"),
    Input("download-etf-btn-pdf", "n_clicks"),
    State("amount-slider", "value"),
    prevent_initial_call=True
)
def generate_pdf(n_clicks, amount):
    df = build_etf_dataframe(amount)
    data = [df.columns.tolist()] + df.values.tolist()

    pdf_path = "etf_allocation.pdf"
    doc = SimpleDocTemplate(pdf_path, pagesize=landscape(A4))
    style = getSampleStyleSheet()["BodyText"]
    style.wordWrap = 'CJK'

    table = Table(data, repeatRows=1)
    table.setStyle(TableStyle([
        ('BACKGROUND', (0, 0), (-1, 0), colors.grey),
        ('TEXTCOLOR', (0, 0), (-1, 0), colors.whitesmoke),
        ('FONTSIZE', (0, 0), (-1, -1), 8),
        ('ALIGN', (0, 0), (-1, -1), 'CENTER'),
        ('VALIGN', (0, 0), (-1, -1), 'MIDDLE'),
        ('GRID', (0, 0), (-1, -1), 0.25, colors.black),
        ('ROWBACKGROUNDS', (0, 1), (-1, -1), [colors.white, colors.lightgrey])
    ]))

    doc.build([table])
    return dcc.send_file(pdf_path)

@app.callback(
    Output("download-etf-docx", "data"),
    Input("download-etf-btn-docx", "n_clicks"),
    State("amount-slider", "value"),
    prevent_initial_call=True
)
def download_docx(n, amount):
    df = build_etf_dataframe(amount)
    doc = Document()
    doc.add_heading("ETF Allocation Table", level=1)
    table = doc.add_table(rows=1, cols=len(df.columns))
    hdr_cells = table.rows[0].cells
    for i, col in enumerate(df.columns):
        hdr_cells[i].text = str(col)
    for _, row in df.iterrows():
        row_cells = table.add_row().cells
        for i, val in enumerate(row):
            row_cells[i].text = str(val)
    docx_path = "etf_allocation.docx"
    doc.save(docx_path)
    return dcc.send_file(docx_path)

